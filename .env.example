# Public site URL used for generating absolute URLs in metadata (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres connection string (used by Drizzle and seed scripts)
# Replace with your Neon connection string; ensure it includes sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxxxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# (Optional) Legacy var name kept for reference if used elsewhere
NEON_DATABASE_URL=postgres://user:password@ep-xxxxxxxx.us-east-1.aws.neon.tech/neondb

# App secrets (examples)
NEON_AUTH_SECRET=changeme-super-secret

# Storage placeholders
NEON_STORAGE_BUCKET=my-app-bucket
NEON_STORAGE_REGION=us-east-1
NEON_STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
NEON_STORAGE_SECRET=change-me-storage-secret
NEON_STORAGE_MAX_BYTES=10485760
NEON_STORAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/avif

# Paystack keys
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key
